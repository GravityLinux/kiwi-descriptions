<image>
  <profiles>
    <profile name="Stable" description="Published Gravity packages"/>
    <profile name="Experimental" description="Stable plus experimental Gravity packages">
      <requires profile="Stable"/>
    </profile>
  </profiles>
  <repository type="rpm-md" alias="gravity" sourcetype="baseurl" priority="1" profiles="Stable">
    <source path="https://download.copr.fedorainfracloud.org/results/adevwithanidea/gravity/fedora-44-aarch64/">
      <signing key="file:///usr/share/gravity-image-builder/RPM-GPG-KEY-gravity"/>
    </source>
  </repository>
  <!-- COPR manual publishing is enabled. Test builds consume its staging repo. -->
  <repository type="rpm-md" alias="gravity-test" sourcetype="baseurl" priority="1" profiles="Workstation-KDE-Test">
    <source path="https://download.copr.fedorainfracloud.org/results/adevwithanidea/gravity/fedora-44-aarch64-devel/">
      <signing key="file:///usr/share/gravity-image-builder/RPM-GPG-KEY-gravity"/>
    </source>
  </repository>
  <repository type="rpm-md" alias="gravity-experimental" sourcetype="baseurl" priority="1" profiles="Experimental">
    <source path="https://download.copr.fedorainfracloud.org/results/adevwithanidea/gravity-experimental/fedora-44-aarch64/">
      <signing key="file:///usr/share/gravity-image-builder/RPM-GPG-KEY-gravity-experimental"/>
    </source>
  </repository>
  <packages type="image" profiles="Experimental">
    <package name="gravity-repos-experimental"/>
  </packages>
</image>
