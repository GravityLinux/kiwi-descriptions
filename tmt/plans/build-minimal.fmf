summary: Build Minimal image
prepare:
  - name: install packages
    how: install
    package:
      - distribution-gpg-keys
      - fatcat
      - git-core
      - kiwi
      - libselinux-utils
      - p7zip-plugins
      - python3-boto3
      - rpmdistro-repoquery
      - zip
      - zstd
discover:
    how: shell
    tests:
      - name: build image
        test: |
          setenforce 0
          $TMT_TREE/builder.py build minimal
          $TMT_TREE/builder.py package minimal
          $TMT_TREE/builder.py tmt minimal
          setenforce 1

execute:
    how: tmt
