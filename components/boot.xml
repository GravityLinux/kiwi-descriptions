<image>
	<profiles>
		<profile name="BootCore" description="Boot core packages"/>
		<profile name="FirmwareRebuild" description="Rebuild firmware from the Python installer raw archive"/>
	</profiles>
	<packages type="bootstrap" patternType="plusRecommended" profiles="BootCore">
		<package name="grubby"/>
	</packages>
	<packages type="image" patternType="plusRecommended" profiles="BootCore">
		<package name="grub2-efi-aa64" arch="aarch64"/>
		<package name="grub2-efi-aa64-modules" arch="aarch64"/>
		<package name="shim-signed-aa64" arch="aarch64"/>
		<package name="grub2-efi-aa64" arch="aarch64"/>
		<package name="uboot-images-armv8" arch="aarch64"/>
		<package name="kernel-16k"/>
		<package name="kernel-16k-modules-extra"/>
		<package name="systemd-oomd-defaults"/>
		<package name="systemd-resolved"/>
		<!-- Gravity boot and firmware consumers -->
		<package name="gravity-bootloader" arch="aarch64"/>
		<package name="dracut-gravity" arch="aarch64"/>
		<package name="update-m1n1" arch="aarch64"/>
	</packages>
	<packages type="image" profiles="FirmwareRebuild">
		<package name="gravity-fwupdate" arch="aarch64"/>
	</packages>
	<!-- Swift already supplies the finished firmware bundle. Reprocessing it
	     with the older Python extractor is deferred until release integration. -->
	<packages type="image" profiles="Experimental">
		<ignore name="gravity-fwupdate"/>
	</packages>
</image>
