<image>
	<profiles>
		<profile name="Common" description="Common packages"/>
	</profiles>
	<packages type="image" patternType="plusRecommended" profiles="Common">
		<namedCollection name="core"/>
		<namedCollection name="standard"/>
		<namedCollection name="hardware-support"/>
		<package name="NetworkManager-wifi"/>
		<package name="chrony"/>
		<package name="glibc-all-langpacks"/>
		<ignore name="dracut-config-rescue"/>
		<ignore name="generic-release*"/>
		<ignore name="generic-logos*"/>
		<!-- pulled in as Recommends: via toolbox -> podman -> containers-common-extra -->
		<ignore name="qemu-user-static"/>
		<!-- ignore *-firmware packages which are unlikely to be used -->
		<ignore name="amd-gpu-firmware"/>
		<ignore name="amd-ucode-firmware"/>
		<ignore name="intel-audio-firmware"/>
		<ignore name="intel-gpu-firmware"/>
		<ignore name="iwlwifi-mvm-firmware"/>
		<ignore name="nvidia-gpu-firmware"/>
		<ignore name="qcom-firmware"/>
		<!-- Retain upstream hardware integration; audio is profile-specific. -->
		<package name="alsa-ucm-asahi"/>
		<package name="gravity-repos"/>
		<package name="gravity-remix-scripts"/>
		<package name="gravity-appstream-metadata"/>
		<package name="gravity-logos"/>
		<package name="tiny-dfr"/>
	</packages>
</image>
