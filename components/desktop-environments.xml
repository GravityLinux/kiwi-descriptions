<image>
	<profiles>
		<profile name="DesktopCommon" description="Common desktop packages">
			<requires profile="Common"/>
		</profile>
		<profile name="KDE-Desktop" description="KDE Plasma Desktop">
			<requires profile="DesktopCommon"/>
		</profile>
		<profile name="Sway-Desktop" description="Sway Wayland desktop">
			<requires profile="Common"/>
		</profile>
	</profiles>
	<packages type="image" patternType="plusRecommended" profiles="DesktopCommon">
		<namedCollection name="firefox"/>
		<namedCollection name="fonts"/>
		<namedCollection name="input-methods"/>
		<namedCollection name="libreoffice"/>
		<namedCollection name="multimedia"/>
		<namedCollection name="printing"/>
		<namedCollection name="x86-emulation"/>
		<package name="aajohan-comfortaa-fonts"/>
		<package name="mediawriter"/>
		<package name="mesa-dri-drivers"/>
		<package name="mesa-vulkan-drivers"/>
		<package name="plymouth-system-theme"/>
		<ignore name="@dial-up"/>
		<ignore name="@guest-desktop-agents"/>
		<ignore name="xorg-x11-server-Xorg"/>
	</packages>
	<packages type="bootstrap" patternType="plusRecommended" profiles="KDE-Desktop">
		<package name="gravity-release-kde"/>
		<package name="gravity-release-identity-kde"/>
	</packages>
	<packages type="image" patternType="plusRecommended" profiles="KDE-Desktop">
		<package name="gravity-platform-metapackage-plasma"/>
		<namedCollection name="kde-desktop-environment"/>
		<namedCollection name="kde-apps"/>
		<namedCollection name="kde-media"/>
		<namedCollection name="kde-pim"/>
		<package name="fuse"/>
		<package name="kde-l10n"/>
		<ignore name="@admin-tools"/>
		<ignore name="initial-setup"/> <!-- redundant with plasma-setup -->
		<ignore name="gnome-disk-utility"/>
		<ignore name="system-config-printer"/>
	</packages>
	<packages type="bootstrap" profiles="Sway-Desktop">
		<package name="gravity-release"/>
		<package name="gravity-release-identity-basic"/>
	</packages>
	<packages type="image" patternType="plusRecommended" profiles="Sway-Desktop">
		<package name="sway"/>
		<package name="sway-config-fedora"/>
		<package name="sddm-wayland-sway"/>
		<package name="initial-setup-gui-wayland-sway"/>
		<package name="foot"/>
		<package name="waybar"/>
		<package name="swaylock"/>
		<package name="swayidle"/>
		<package name="xdg-desktop-portal-wlr"/>
		<package name="xdg-desktop-portal-gtk"/>
		<package name="firefox"/>
		<package name="mesa-dri-drivers"/>
		<package name="mesa-vulkan-drivers"/>
		<namedCollection name="fonts"/>
	</packages>
</image>
